{$DOMAIN:localhost} {
	# Backend routes — everything the FastAPI app actually serves. See
	# backend/main.py and backend/api/routes/*.py for the source of truth.
	@backend path /auth/* /trades/* /portfolio/* /leaderboard/* /seasons/* /ai/* /api/* /price/* /score/* /ws/* /health /docs /redoc /openapi.json

	reverse_proxy @backend backend:8000

	# Everything else — the React SPA.
	reverse_proxy frontend:80
}
