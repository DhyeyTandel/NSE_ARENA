# NSE Arena — Backend Environment Variables
# Copy this file to .env and fill in your values. backend/.env is
# gitignored — never commit real secrets.

# "development" (default) or "production". config.py refuses to boot in
# production against a sqlite DATABASE_URL, since row-locking guarantees
# (with_for_update) are a silent no-op on SQLite.
ENV=development

# Async SQLAlchemy URL. Defaults to a local SQLite file if unset — fine for
# dev, but production must use Postgres (see ENV above).
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nse_arena

# Redis is used for price caching/pub-sub and (see ANTIGRAVITY_NEXT.md
# item 5) rate limiting.
REDIS_URL=redis://localhost:6379

# Required — the app refuses to boot without a real value here (or with
# the literal placeholder below). Signs all JWTs; generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Optional — the AI trading agent (ai/scheduler.py) is disabled without it.
GROQ_API_KEY=
# Optional — override the Groq chat model (must support JSON mode).
# GROQ_MODEL=openai/gpt-oss-120b

# Seconds between live price polls while NSE is open (default 15, minimum 5)
# PRICE_POLL_INTERVAL_SECONDS=15

# Optional — Zerodha Kite Connect real-time prices (read-only; the app never
# places orders). Both empty = Yahoo polling only. Register the redirect URL
# https://<your-host>/api/kite/callback in the Kite developer console, then
# click "Connect Kite" on the dashboard once per trading day.
KITE_API_KEY=
KITE_API_SECRET=
# Comma-separated usernames allowed to Connect/Disconnect Kite (case-insensitive).
# Empty = nobody can. Register the account first; reserve the name early.
ADMIN_USERNAMES=
# Where the Kite callback redirects afterwards. Empty = same-origin "/" (prod).
# Local dev: http://localhost:5173
FRONTEND_URL=
