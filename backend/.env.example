# NSE Arena — Backend Environment Variables
# Copy this file to .env and fill in your values. backend/.env is
# gitignored — never commit real secrets.

# "development" (default) or "production". config.py refuses to boot in
# production against a sqlite DATABASE_URL, since row-locking guarantees
# (with_for_update) are a silent no-op on SQLite.
ENV=development

# Async SQLAlchemy URL. Defaults to a local SQLite file if unset — fine for
# dev, but production must use Postgres (see ENV above).
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nse_arena

# Redis is used for price caching/pub-sub and (see ANTIGRAVITY_NEXT.md
# item 5) rate limiting.
REDIS_URL=redis://localhost:6379

# Required — the app refuses to boot without a real value here (or with
# the literal placeholder below). Signs all JWTs; generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Optional — the AI trading agent (ai/scheduler.py) is disabled without it.
GEMINI_API_KEY=
