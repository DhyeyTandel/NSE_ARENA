# .env.deploy — docker-compose secrets for production deployment.
# Copy to .env.deploy and fill in real values. .env.deploy is gitignored
# — never commit it. docker-compose's default env file is `.env`, not
# this one, so pass it explicitly:
#   docker-compose --env-file .env.deploy up --build

# Postgres password for the "user" account docker-compose creates.
POSTGRES_PASSWORD=

# Redis AUTH password (--requirepass). Required — redis has no host port
# published, but requirepass still matters since other containers on the
# same Docker network could otherwise connect unauthenticated.
REDIS_PASSWORD=

# JWT signing secret — same requirement as backend/.env. Generate with
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
SECRET_KEY=

# Optional — AI trading agent is disabled without it.
GEMINI_API_KEY=

# Domain Caddy should request a certificate for (automatic HTTPS via
# Let's Encrypt). Leave unset / "localhost" for local testing, where
# Caddy serves plain HTTP instead.
DOMAIN=
